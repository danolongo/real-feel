POSTGRES_PASSWORD=

# Local services. Replace <password> with POSTGRES_PASSWORD.
DATABASE_URL=postgres://realfeel:<password>@localhost:5433/realfeel
SCRAPER_QUEUE_URL=http://localhost:4566/000000000000/scraper-jobs
CLASSIFIER_QUEUE_URL=http://localhost:4566/000000000000/classifier-jobs
SCRAPER_DLQ_URL=http://localhost:4566/000000000000/scraper-jobs-dlq
CLASSIFIER_DLQ_URL=http://localhost:4566/000000000000/classifier-jobs-dlq
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# The versions the API uses to pick one prediction for each tweet
DEFAULT_MODEL_VERSION=clef-flash-hosted
DEFAULT_METADATA_VERSION=v1
DEFAULT_QUESTION_VERSION=v1

# Worker choices (from M2). SCRAPER: twitterapi or fixture. CLASSIFIER: hosted or fake.
SCRAPER=twitterapi
TWITTERAPI_KEY=
TWITTERAPI_PAGES=5
TWITTERAPI_INTERVAL_SECS=5
CLASSIFIER=hosted
CLASSIFIER_RPS=5
BATCH_SIZE=25
JOB_DEADLINE_SECS=240

# Cloudflare Workers AI, the hosted backend (from M2)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Datadog agent on each instance (from M3)
DD_API_KEY=
DD_SITE=datadoghq.com
